	set(goId0, "String", "This example shows the use of 5 new eye calculation functions. The AEL code for the functions are listed on the\nfollowing data display pages. These functions are:\neye_amplitude - essentially takes a vertical histogram of the eye voltages, and subtracts the '0' level mean from\n                           the '1' level mean within a given measurement window.\neye_height - also using histograms, computes the inner bounds of the eye opening\neye_closure - a ratio of the eye height to the eye amplitude.\neye_rise_time- Computes 20%-80% rise time \neye_fall_time- Computes 80%-20% fall time  \n\nThe eye parameter functions are incorporated in ADS2003A release and no longer required to be defined as user\ndefined functions.\n\nNOTE : Please place marker ( samplPt ) on the eye diagram trace for eye parameter equations to work properly \n             in this template otherwise the eye parameter equations will appear in red color.\n");
	set(goId0, "Font", "Arial For CAE");
	set(goId0, "FontSize", 194);
	set(goId0, "TextColor", 21);
	set(goId0, "FillPattern", -1);
	set(goId0, "FillColor", 0);
	set(goId0, "OutlineOnOff", FALSE);
// Base Class Object:
	set(goId0, "Name", "");
	set(goId0, "Uid", 389713045);
// Graphical Object:
	set(goId0, "Right", 9895);
	set(goId0, "Bottom", -574);
	set(goId0, "Left", 133);
	set(goId0, "Top", -3484);
	set(goId0, "Zrot", 0.000000);
	set(goId0, "Yrot", 0.000000);
	set(goId0, "Xrot", 0.000000);
	set(goId0, "Status", 0);
	set(goId0, "LineColor", 0);
	set(goId0, "LineType", 0);
	set(goId0, "LineWidth", 7);
