TECHFORMAT=V2

UNITS
  DISTANCE=METRE
  CONDUCTIVITY=SIEMENS/M
  RESISTIVITY=OHM.CM
  RESISTANCE=OHM/SQ
  PERMITTIVITY=RELATIVETOVACUUM
  PERMEABILITY=RELATIVETOVACUUM
  FREQUENCY=HZ
  TEMPERATURE=CELSIUS
END_UNITS

BEGIN_MATERIAL
  MATERIAL Copper CONDUCTIVITY=5.8e7 IMAG_CONDUCTIVITY=0 PERMEABILITY=1
  MATERIAL FR_4 PERMITTIVITY=4.6 LOSSTANGENT=0.01 PERMEABILITY=1 DJORDJEVIC LOWFREQ=1000 VALUEFREQ=1e+09 HIGHFREQ=1e+12
  MATERIAL FR_4_Prepreg PERMITTIVITY=4.6 LOSSTANGENT=0.01 PERMEABILITY=1 DJORDJEVIC LOWFREQ=1000 VALUEFREQ=1e+09 HIGHFREQ=1e+12
END_MATERIAL

BEGIN_OPERATION
  OPERATION OperationSHEET SHEET
  OPERATION OperationThickness_cond EXPAND=1.7e-05 UP
  OPERATION OperationThickness_Layer2 INTRUDE=1e-05 DOWN
  OPERATION OperationThickness_Layer3 INTRUDE=0 UP
  OPERATION OperationThickness_Layer4 EXPAND=1.7e-05 DOWN
  OPERATION OperationDRILL DRILL
  OPERATION OperationTSV_viaL1_L4 DRILL
  OPERATION OperationTSV_L1_L2 DRILL
END_OPERATION

BEGIN_MASK
  MASK 1 Name=cond PRECEDENCE=0 COLOR="ee6a50" MATERIAL=Copper OPERATION=OperationThickness_cond
  MASK 40 Name=Layer2 PRECEDENCE=0 COLOR="ffff00" MATERIAL=Copper OPERATION=OperationThickness_Layer2
  MASK 41 Name=Layer3 NEGATIVE PRECEDENCE=0 COLOR="008000" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationThickness_Layer3
  MASK 42 Name=Layer4 PRECEDENCE=0 COLOR="00ffff" MATERIAL=Copper OPERATION=OperationThickness_Layer4
  MASK 43 Name=viaL1_L4 PRECEDENCE=0 COLOR="008000" MATERIAL=Copper OPERATION=OperationDRILL
  MASK 44 Name=L1_L2 PRECEDENCE=0 COLOR="00008b" MATERIAL=Copper OPERATION=OperationDRILL
END_MASK

BEGIN_STACK
  Name=substrate1
  PRECEDENCE=0
  TOP OPEN MATERIAL=AIR
  INTERFACE Name=__Interface3      MASK={cond}
  LAYER     Name=__SubstrateLayer3 MASK={viaL1_L4 L1_L2} HEIGHT=0.0006 MATERIAL=FR_4
  INTERFACE Name=__Interface2      MASK={Layer2}
  LAYER     Name=__SubstrateLayer2 MASK={viaL1_L4} HEIGHT=0.00012 MATERIAL=FR_4_Prepreg
  INTERFACE Name=__Interface1      MASK={Layer3}
  LAYER     Name=__SubstrateLayer1 MASK={viaL1_L4} HEIGHT=0.0006 MATERIAL=FR_4
  INTERFACE Name=__Interface0      MASK={Layer4}
  BOTTOM OPEN MATERIAL=AIR
END_STACK

