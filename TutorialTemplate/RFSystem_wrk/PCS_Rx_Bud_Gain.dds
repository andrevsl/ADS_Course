// Text:
	set(goId0, "String", "The function bud_gain() gives the transducer power \ngain (in dB) from the input terminal (PORT1) to \npin 1 of each component, at each frequency.  \nWhat is of interest to the user is the gain\nat one particular frequency.  For example, \nwe are interested in the gain to the\nRF filters at the RF frequency, and to the \nIF filters, at the IF frequency.  The equations\nbelow allow the user to specify the component\nand frequency at which the gain is \nto be computed.  Note that in the bud_gain() \nequation, the voltage and current at the input \nfrequency must be specified (via the indx_F_RF \nvariable) so that a reference can be established \nfor computing gain.");
	set(goId0, "Font", "Arial For CAE");
	set(goId0, "FontSize", 166);
	set(goId0, "TextColor", 0);
	set(goId0, "FillPattern", -1);
	set(goId0, "FillColor", 0);
	set(goId0, "OutlineOnOff", FALSE);
