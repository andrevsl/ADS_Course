MethodMapTable={1,1,0,0,0,0,1,1}
SymsPerOppTable={2,4,1,3,1,3,2,4}
RangingNumOfSyms=RangingAllocation[3]
Condition=MethodMapTable[int(RangingMethod)+1]
SymsPerOpp=SymsPerOppTable[int(RangingMethod)+1]
EmptySyms=fmod(RangingNumOfSyms,SymsPerOpp)
FFTLen =2^FFTOrder
FFTOrder =if(FFTSize==0) then 11+int(OversamplingOption) elseif(FFTSize==1) then 10+int(OversamplingOption) else 9+int(OversamplingOption) endif
n_num=if(0==fmod(int(Bandwidth),1750000)) then 8 elseif(0==fmod(int(Bandwidth),1500000)) then 28 elseif(0==fmod(int(Bandwidth),1250000)) then 28 elseif(0==fmod(int(Bandwidth),2750000)) then 28 elseif(0==fmod(int(Bandwidth),2000000)) then 28 else 8 endif
n_den=if(0==fmod(int(Bandwidth),1750000)) then 7 elseif(0==fmod(int(Bandwidth),1500000)) then 25 elseif(0==fmod(int(Bandwidth),1250000)) then 25 elseif(0==fmod(int(Bandwidth),2750000)) then 25 elseif(0==fmod(int(Bandwidth),2000000)) then 25 else 7 endif
SamplingRate=floor(Bandwidth*n_num/(n_den*8000))*8000*2^int(OversamplingOption)
FrameDur_Table={2ms, 2.5 ms, 4 ms, 5 ms, 8 ms, 10 ms, 12.5 ms, 20 ms}
TimingOffsetInSamples=int(RangingTimingOffset*SamplingRate)
IdleSize=int(IdleInterval * SamplingRate)
FrameSample=int(FrameDur_Table[int(FrameDuration)+1]*SamplingRate)
UL_FrameOffset=if(FrameMode==0) then 0 else int(FrameSample*DL_Ratio) endif
end WMAN_M_UL_RangingGuard

