R:R2  N__1 0 R=50 Ohm Temp=RX_AntTemp - 273.15 Noise=yes 

HB:Env1 Freq[1]=1.9 GHz \
Freq[2]=2 GHz \
 Order[1]=1 \
Order[2]=1 \
 Oversample[1]=4 \
Oversample[2]=4 \
 NoiseFreqPlan="Env1_nl_stim"   MaxOrder=2 StatusLevel=0 FundOversample=4 MaxIters=250 SamanskiiConstant=2 \
 Restart=no ArcLevelMaxStep=0.0 MaxStepRatio=100 MaxShrinkage=1.0e-5 ArcMaxStep=0.0 \
 UseGear=no EnvIntegOrder=1 EnvNoise=yes EnvBandwidth=1 EnvWarnPoorFit=no \
 EnvUsePoorFit=no SweepVar="time" InputFreq=100 MHz NoiseInputPort=1 NoiseOutputPort=2 \
 PhaseNoise=no SortNoise=0 BandwidthForNoise=1.0 Hz DevOpPtLevel=0 UseInFile=no \
 UseOutFile=no UseKrylov=0 ConvMode=2 EnvFitDisableCache=no SweepPlan="Env1_stim" OutputPlan="Env1_Output"

OutputPlan:Env1_Output \
       Type="Output" \
       UseNodeNestLevel=yes \
       NodeNestLevel=2 \
       UseEquationNestLevel=yes \
       EquationNestLevel=2 \
       UseSavedEquationNestLevel=yes \
       SavedEquationNestLevel=2 \
       UseDeviceCurrentNestLevel=no \
       DeviceCurrentNestLevel=0 \
       DeviceCurrentDeviceType="All" \
       DeviceCurrentSymSyntax=yes \
       UseCurrentNestLevel=yes \
       CurrentNestLevel=999 \
       UseDeviceVoltageNestLevel=no \
       DeviceVoltageNestLevel=0 \
       DeviceVoltageDeviceType="All" 

SweepPlan:Env1_stim Stop=2000 usec Step=2.5 usec

Tran:Env1_tran HB_Sol=1 SteadyState=1 StatusLevel=3 \
 Freq[1]=1.9 GHz \
 Order[1]=1 \
 OutputPlan="Env1_Output"

Component:tahb_Env1 Module="ATAHB" Type="ModelExtractor" Tran_Analysis="Env1_tran" HB_Analysis="Env1"

SweepPlan:Env1_nl_stim  Center=100 MHz Span=1 MHz Lin=101
#uselib "ckt" , "BPF_Butterworth"
BPF_Butterworth:BPF1  N__2 N__5 Fcenter=2 GHz BWpass=RF_BW Apass=1 dB BWstop=1.2 GHz Astop=40 dB StopType="open" N=5 IL=0 dB Qu=1E308 Z1=50 Ohm Z2=50 Ohm Temp=-273.15 
Amplifier:AMP1  N__5 N__6 S21=dbpolar(20,180) S11=0. S22=0. S12=0. NF=amp_nf dB GainCompType=0 ReferToInput=1 TOI=100 GainComp=1. ClipDataFile=0 
Mixer:MIX1  N__6 Port2 N__7 SideBand=0 ConvGain=10+j*0. S11=0. S22=0. S33=0. NF=10 dB GainCompType=0 ReferToInput=1 TOI=100 GainComp=1. 
V_Source:SRC2  N__8 0 Type="V_1Tone" V[1]=50 mV Freq[1]=1.9 GHz    SaveCurrent=1 
R:R1  N__8 N__7 R=50 Ohm Noise=yes 
end RF_downcon

