pageId = get_new(ddoId, "Page");
goId0 = get_new(pageId, "Text");
// Text:
	set(goId0, "String", "//****************************************************************************\n//\n// File:         tdr_sp_gamma.ael\n// Description:  Simplifies calculation of TDR reflection coeff\n//\n// (C) Copyright 2001, Keysight Technologies, all rights reserved.\n//\n// This function takes an S-parameter dataset and changes it to a step\n// response. The step response is normalized and used to plot reflection \n// coefficient vs. time.\n//\n// Usage: x=tdr_sp_gamma(Sdataset,delay,start time,stop time,num pts,window)\n//\n//****************************************************************************\n\n\ndefun tdr_sp_gamma(data,delay,start,stop,numpts,window)\n{\n                decl NumFreqPts=sweep_size(indep(data));\n                decl BandWidth=max(indep(data))-min(indep(data));\n                decl LaPlaceNorm=1/(j*2*pi*indep(data));\n                decl DelayPhasor=exp(-j*2*pi*indep(data)*delay);\n                decl Gamma=data*DelayPhasor*(2*BandWidth/NumFreqPts)*LaPlaceNorm;\n                decl Time_Gamma=ts(Gamma,start,stop,numpts,,window);\n\n                 return Time_Gamma;\n}\n\n");
	set(goId0, "Font", "Arial For CAE");
	set(goId0, "FontSize", 167);
	set(goId0, "TextColor", 0);
	set(goId0, "FillPattern", -1);
	set(goId0, "FillColor", 0);
	set(goId0, "OutlineOnOff", FALSE);
// Base Class Object:
	set(goId0, "Name", "");
	set(goId0, "Uid", 1394715719);
// Graphical Object:
	set(goId0, "Right", 6364);
	set(goId0, "Bottom", 4973);
	set(goId0, "Left", -122);
	set(goId0, "Top", 130);
	set(goId0, "Zrot", 0.000000);
	set(goId0, "Yrot", 0.000000);
	set(goId0, "Xrot", 0.000000);
	set(goId0, "Status", 0);
	set(goId0, "LineColor", 0);
	set(goId0, "LineType", 0);
	set(goId0, "LineWidth", 7);
// Base Class Object:
	set(pageId, "Name", "tdr_sp_gamma.ael");
	set(pageId, "Uid", 1517554403);
	set(pageId, "Invisible", FALSE);
pageId = get_new(ddoId, "Page");
goId0 = get_new(pageId, "Text");
// Text:
	set(goId0, "String", "//****************************************************************************\n//\n// File:         tdr_sp_imped.ael\n// Description:  Simplifies calculation of TDR impedance versus time\n//\n// (C) Copyright 2001, Keysight Technologies, all rights reserved.\n//\n// This function takes an S-parameter dataset and changes it to a step\n// response. The step response is normalized and used to calculate reflection \n// coefficient vs. time. This gamma is then used to calculate impedance\n// versus time.\n//\n// Usage: x=tdr_sp_imped(Sdataset,delay,ref imped,start time,stop time,num pts,window)\n//\n//****************************************************************************\n\n\ndefun tdr_sp_imped(data,delay,refimped,start,stop,numpts,window)\n{\n                decl NumFreqPts=sweep_size(indep(data));\n                decl BandWidth=max(indep(data))-min(indep(data));\n                decl LaPlaceNorm=1/(j*2*pi*indep(data));\n                decl DelayPhasor=exp(-j*2*pi*indep(data)*delay);\n                decl Gamma=data*DelayPhasor*(2*BandWidth/NumFreqPts)*LaPlaceNorm;\n                decl Time_Gamma=ts(Gamma,start,stop,numpts,,window);\n                decl Time_Imped=mag(zin(Time_Gamma-Time_Gamma[0],refimped));\n\n                 return Time_Imped;\n}\n\n");
	set(goId0, "Font", "Arial For CAE");
	set(goId0, "FontSize", 167);
	set(goId0, "TextColor", 0);
	set(goId0, "FillPattern", -1);
	set(goId0, "FillColor", 0);
	set(goId0, "OutlineOnOff", FALSE);
