	set(goId0, "String", "When Analysis Data Type is set to 2, The Jitres[5] JitRes[6] JitRes[7] and JitRes[17] May be invalid\nOr even if they are not Invalid, the results may be questionable.  These components are the ISIpp, DCD, DDJpp and DDJvs Bit\nin that order.\nThe other components are expected to be within 5% of the values determined by treating the input as a periodic sequence.\n\nUse cross( Vout ) instead of passing in Vout directly to speed up calculation.\nchange the Analysis Data Type to 2 to treat the input sequence as ARBITRARY\n\nOnly one of the four equations shown here can be active at a given time.");
	set(goId0, "Font", "Arial For CAE");
	set(goId0, "FontSize", 167);
